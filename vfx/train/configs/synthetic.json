{
  "name": "synthetic",
  "dataset": "synthetic",
  "hypothesis": "Pipeline validation on procedural synthetic data: short run should beat bicubic on L1 and spectrum error on held-out synthetic scenes.",
  "model": {"lr_channels": 64, "n_blocks": 8, "hr_feats": 8, "hr_hidden": 16, "vel_scale": "auto"},
  "train": {"minutes": 5.0, "batch": 16, "crop_hr": 256, "lr": 1e-3, "preload": true},
  "loss": {"l1": 1.0, "grad": 0.5, "hf": 1.0, "spec": 0.05, "temporal": 0.5},
  "exposure": {"p_cold": 0.1, "p_rollout": 0.4, "noise_sigma": 0.1},
  "eval": {"split": "test", "max_scenarios": 8}
}
